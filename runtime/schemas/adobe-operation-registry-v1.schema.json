{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkroom-finish.local/schemas/adobe-operation-registry-v1.schema.json",
  "title": "darkroom-finish Adobe operation registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "registry_id", "version", "target_environment", "promotion_requirements", "enum_domains", "operations", "registry_sha256"],
  "properties": {
    "$schema": {"const": "https://darkroom-finish.local/schemas/adobe-operation-registry-v1.schema.json"},
    "schema_version": {"const": "adobe-operation-registry/v1"},
    "registry_id": {"const": "adobe.operations"},
    "version": {"$ref": "formula-dsl-v1.schema.json#/$defs/Semver"},
    "target_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photoshop", "camera_raw", "process_version"],
      "properties": {
        "photoshop": {"type": "string", "minLength": 1},
        "camera_raw": {"type": "string", "minLength": 1},
        "process_version": {"type": "string", "minLength": 1}
      }
    },
    "promotion_requirements": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["documented", "schema_representable", "executor_write", "executor_readback", "fixture_probe", "replay"]}
    },
    "enum_domains": {
      "type": "array",
      "items": {"$ref": "#/$defs/EnumDomain"}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Operation"}
    },
    "registry_sha256": {"$ref": "formula-dsl-v1.schema.json#/$defs/Sha256"}
  },
  "$defs": {
    "EnumDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_id", "version", "values", "native_values", "registry_sha256"],
      "properties": {
        "schema_version": {"const": "adobe-operation-enum-domain/v1"},
        "registry_id": {"$ref": "formula-dsl-v1.schema.json#/$defs/Identifier"},
        "version": {"$ref": "formula-dsl-v1.schema.json#/$defs/Semver"},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "formula-dsl-v1.schema.json#/$defs/EnumToken"}
        },
        "native_values": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "registry_sha256": {"$ref": "formula-dsl-v1.schema.json#/$defs/Sha256"}
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "unverified", "not_applicable"]},
        "evidence_ref": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    },
    "NativeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "inclusivity"],
      "properties": {
        "lower": {"$ref": "formula-dsl-v1.schema.json#/$defs/DecimalString"},
        "upper": {"$ref": "formula-dsl-v1.schema.json#/$defs/DecimalString"},
        "inclusivity": {"enum": ["closed", "open", "left_closed", "right_closed"]}
      }
    },
    "Transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": {"enum": ["xmp_attribute", "xmp_rdf_seq", "xmp_mask_graph", "action_descriptor", "local_raster_recipe"]},
        "key": {"type": "string", "minLength": 1},
        "companion_attributes": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "field", "product", "family", "value_type", "native_unit", "native_range", "enum_domain_ref", "scope", "charter_class", "transport", "evidence"],
      "properties": {
        "operation_id": {"$ref": "formula-dsl-v1.schema.json#/$defs/Identifier"},
        "field": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "formula-dsl-v1.schema.json#/$defs/Identifier"}
          ]
        },
        "product": {"enum": ["camera_raw", "photoshop", "local_raster"]},
        "family": {"$ref": "formula-dsl-v1.schema.json#/$defs/Identifier"},
        "value_type": {"enum": ["scalar", "enum", "curve", "mask_graph", "layer_graph", "action"]},
        "native_unit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "formula-dsl-v1.schema.json#/$defs/UnitId"}
          ]
        },
        "native_range": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/NativeRange"}
          ]
        },
        "enum_domain_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "formula-dsl-v1.schema.json#/$defs/EnumDomainRef"}
          ]
        },
        "scope": {"enum": ["global", "local", "document"]},
        "charter_class": {"enum": ["allowed", "conditional", "prohibited"]},
        "transport": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/Transport"}
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documented", "schema_representable", "executor_write", "executor_readback", "fixture_probe", "replay"],
          "properties": {
            "documented": {"$ref": "#/$defs/Evidence"},
            "schema_representable": {"$ref": "#/$defs/Evidence"},
            "executor_write": {"$ref": "#/$defs/Evidence"},
            "executor_readback": {"$ref": "#/$defs/Evidence"},
            "fixture_probe": {"$ref": "#/$defs/Evidence"},
            "replay": {"$ref": "#/$defs/Evidence"}
          }
        }
      }
    }
  }
}
